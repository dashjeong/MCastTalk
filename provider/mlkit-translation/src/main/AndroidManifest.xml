<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          TranslateJni can abort its hosting process during a native failure and a Google Task
          cannot be cancelled once native inference has started. Each live target therefore owns
          a distinct non-exported process. Catalog inspection/deletion remains in the main
          process; selected-language download, warm-up, and inference use the isolated worker.
        -->
        <service
            android:name=".MlKitInferenceService0"
            android:exported="false"
            android:process=":mlkit_translate_0"
            android:stopWithTask="false" />
        <service
            android:name=".MlKitInferenceService1"
            android:exported="false"
            android:process=":mlkit_translate_1"
            android:stopWithTask="false" />
        <service
            android:name=".MlKitInferenceService2"
            android:exported="false"
            android:process=":mlkit_translate_2"
            android:stopWithTask="false" />
        <service
            android:name=".MlKitInferenceService3"
            android:exported="false"
            android:process=":mlkit_translate_3"
            android:stopWithTask="false" />
        <service
            android:name=".MlKitInferenceService4"
            android:exported="false"
            android:process=":mlkit_translate_4"
            android:stopWithTask="false" />
        <service
            android:name=".MlKitInferenceService5"
            android:exported="false"
            android:process=":mlkit_translate_5"
            android:stopWithTask="false" />
        <service
            android:name=".MlKitInferenceService6"
            android:exported="false"
            android:process=":mlkit_translate_6"
            android:stopWithTask="false" />
    </application>
</manifest>
