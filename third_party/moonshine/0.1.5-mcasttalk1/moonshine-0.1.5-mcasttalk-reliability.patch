+
+struct VoiceActivityDetectorRestartTestAccess {
+  static void seed_previous_session(VoiceActivityDetector &vad) {
+    std::fill(vad.probability_window.begin(), vad.probability_window.end(), 0.9f);
+    std::fill(vad.look_behind_audio_buffer.begin(),
+              vad.look_behind_audio_buffer.end(), 0.25f);
+  }
+  static bool windows_are_zero(const VoiceActivityDetector &vad) {
+    const auto is_zero = [](float value) { return value == 0.0f; };
+    return std::all_of(vad.probability_window.begin(),
+                       vad.probability_window.end(), is_zero) &&
+           std::all_of(vad.look_behind_audio_buffer.begin(),
+                       vad.look_behind_audio_buffer.end(), is_zero);
+  }
+};
+
+TEST_CASE("vad-restart-clears-prior-session-confidence-and-audio") {
+  constexpr size_t hop = 512;
+  // With an eight-hop window, a single prediction cannot exceed threshold
+  // after reset, regardless of the shared Silero model's recurrent state.
+  VoiceActivityDetector vad(0.5f, 8, hop, 4 * hop, 12 * 16000);
+  vad.start();
+  VoiceActivityDetectorRestartTestAccess::seed_previous_session(vad);
+  REQUIRE_FALSE(VoiceActivityDetectorRestartTestAccess::windows_are_zero(vad));
+  vad.stop();
+  vad.start();
+  CHECK(VoiceActivityDetectorRestartTestAccess::windows_are_zero(vad));
+  const std::vector<float> silence(hop, 0.0f);
+  vad.process_audio(silence.data(), silence.size(), 16000);
+  CHECK(vad.get_segments()->empty());
+  vad.stop();
+}
+
+TEST_CASE("vad-duration-scale-decreases-without-discontinuity") {
+  constexpr size_t maximum = 12 * 16000;
+  constexpr size_t fade_start = 8 * 16000;
+  CHECK(vad_duration_scale(0, maximum) == 1.0f);
+  CHECK(vad_duration_scale(fade_start, maximum) == 1.0f);
+  CHECK(vad_duration_scale(fade_start + 512, maximum) ==
+        doctest::Approx(0.992f));
+  CHECK(vad_duration_scale(10 * 16000, maximum) ==
+        doctest::Approx(0.5f));
+  CHECK(vad_duration_scale(maximum, maximum) == 0.0f);
+  CHECK(vad_duration_scale(maximum + 512, maximum) == 0.0f);
+  CHECK(vad_duration_scale(maximum + 512, 0) == 1.0f);
+}
+
+TEST_CASE("vad-disabled-still-closes-bounded-segments") {
+  constexpr size_t hop = 512;
+  constexpr size_t maximum = 8 * hop;
+  VoiceActivityDetector vad(0.0f, 1, hop, hop, maximum);
+  const std::vector<float> audio(40 * hop, 0.25f);
+  vad.start();
+  for (size_t offset = 0; offset < audio.size(); offset += hop) {
+    vad.process_audio(audio.data() + offset, hop, 16000);
+  }
+  vad.stop();
+  const auto *segments = vad.get_segments();
+  REQUIRE(segments->size() >= 4);
+  for (const auto &segment : *segments) {
+    CHECK(segment.is_complete);
+    CHECK_FALSE(segment.audio_data.empty());
+    // A boundary is checked once per hop; at most one extra hop is retained.
+    CHECK(segment.audio_data.size() <= maximum + hop);
+  }
+}
 
