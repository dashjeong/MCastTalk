+// GetFloatArrayElements may allocate or pin. Every successful acquisition must
+// be released even when a native call fails or throws. Input PCM is read-only.
+class ScopedInputFloatArray {
+ public:
+  ScopedInputFloatArray(JNIEnv *env, jfloatArray array)
+      : env_(env), array_(array),
+        data_(env->GetFloatArrayElements(array, nullptr)) {}
+  ~ScopedInputFloatArray() {
+    if (data_ != nullptr) env_->ReleaseFloatArrayElements(array_, data_, JNI_ABORT);
+  }
+  ScopedInputFloatArray(const ScopedInputFloatArray &) = delete;
+  ScopedInputFloatArray &operator=(const ScopedInputFloatArray &) = delete;
+  float *get() const { return data_; }
+
+ private:
+  JNIEnv *env_;
+  jfloatArray array_;
+  jfloat *data_;
+};
+
+class ScopedInputUtf {
+ public:
+  ScopedInputUtf(JNIEnv *env, jstring text)
+      : env_(env), text_(text),
+        data_(text != nullptr ? env->GetStringUTFChars(text, nullptr) : nullptr) {}
+  ~ScopedInputUtf() {
+    if (data_ != nullptr) env_->ReleaseStringUTFChars(text_, data_);
+  }
+  ScopedInputUtf(const ScopedInputUtf &) = delete;
+  ScopedInputUtf &operator=(const ScopedInputUtf &) = delete;
+  const char *get() const { return data_; }
+
+ private:
+  JNIEnv *env_;
+  jstring text_;
+  const char *data_;
+};
+
+static void throw_transcription_error(JNIEnv *env, const char *operation,
+                                      int error) {
+  if (env->ExceptionCheck()) return;
+  jclass exception = env->FindClass("java/lang/IllegalStateException");
+  if (exception == nullptr) return;  // Preserve FindClass's pending exception.
+  char message[160];
+  std::snprintf(message, sizeof(message), "%s failed, native code %d", operation,
+                error);
+  env->ThrowNew(exception, message);
+  env->DeleteLocalRef(exception);
+}
 
