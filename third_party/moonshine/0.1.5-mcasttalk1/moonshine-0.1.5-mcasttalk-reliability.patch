+#ifndef VAD_DURATION_SCALE_H
+#define VAD_DURATION_SCALE_H
+
+#include <cstddef>
+
+// The duration bound is a decoder resource limit, not a semantic sentence end.
+// Keep full confidence through the first two thirds, then decrease continuously
+// to zero. Zero must be reached even when voice detection is disabled.
+inline float vad_duration_scale(size_t sample_count, size_t maximum_samples) {
+  if (maximum_samples == 0) return 1.0f;
+  const size_t fade_start =
+      (maximum_samples / 3) * 2 + ((maximum_samples % 3) * 2) / 3;
+  if (sample_count <= fade_start) return 1.0f;
+  if (sample_count >= maximum_samples) return 0.0f;
+  return static_cast<float>(maximum_samples - sample_count) /
+         static_cast<float>(maximum_samples - fade_start);
+}
+
+#endif
