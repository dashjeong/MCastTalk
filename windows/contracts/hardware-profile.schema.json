{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcasttalk.local/schemas/hardware-profile-v2.json",
  "title": "MCastTalk Hardware Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fingerprint",
    "capturedAt",
    "os",
    "cpu",
    "logicalCores",
    "memoryBytes",
    "accelerators",
    "provisionalTier",
    "calibrationRequired"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "capturedAt": {"type": "string", "format": "date-time"},
    "os": {"type": "string"},
    "cpu": {"type": "string"},
    "logicalCores": {"type": "integer", "minimum": 1},
    "memoryBytes": {"type": "integer", "minimum": 0},
    "accelerators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "vendor",
          "deviceId",
          "memoryBytes",
          "memoryKind",
          "backendCandidates",
          "probeSources"
        ],
        "properties": {
          "name": {"type": "string"},
          "vendor": {"type": "string"},
          "deviceId": {"type": ["string", "null"]},
          "memoryBytes": {"type": "integer", "minimum": 0},
          "memoryKind": {
            "enum": ["dedicated", "reported", "shared", "unknown"]
          },
          "driverVersion": {"type": ["string", "null"]},
          "computeCapability": {"type": ["string", "null"]},
          "backendCandidates": {
            "type": "array",
            "items": {
              "enum": ["vulkan", "winml", "directml", "openvino", "cuda", "tensorrt", "hip", "qnn"]
            },
            "uniqueItems": true
          },
          "probeSources": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"},
            "uniqueItems": true
          }
        }
      }
    },
    "provisionalTier": {
      "enum": ["cpu-only", "accelerator-unmeasured", "entry-accelerated", "balanced", "performance"]
    },
    "calibrationRequired": {"const": true},
    "notes": {
      "type": "array",
      "items": {"type": "string"}
    }
  }
}
