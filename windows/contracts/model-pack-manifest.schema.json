{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcasttalk.local/schemas/model-pack-manifest-v2.json",
  "title": "MCastTalk Offline Model Pack Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageId",
    "version",
    "component",
    "engine",
    "supportedBackends",
    "licenseSpdx",
    "distributionAllowed",
    "supportedLanguages",
    "files"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "packageId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{2,127}$"
    },
    "version": {"type": "string", "minLength": 1, "maxLength": 64},
    "component": {"enum": ["asr", "nmt", "tts", "vad", "llm"]},
    "engine": {"type": "string", "minLength": 1, "maxLength": 128},
    "supportedBackends": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "cpu",
          "vulkan",
          "winml",
          "directml",
          "openvino",
          "cuda",
          "tensorrt",
          "hip",
          "qnn"
        ]
      }
    },
    "sourceUrl": {"type": "string", "format": "uri"},
    "sourceRevision": {"type": "string", "maxLength": 128},
    "licenseSpdx": {"type": "string", "minLength": 1, "maxLength": 128},
    "distributionAllowed": {"type": "boolean"},
    "supportedLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
      }
    },
    "minimumHardwareProfile": {
      "enum": ["cpu-only", "accelerator-unmeasured", "entry-accelerated", "balanced", "performance"]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "sizeBytes"],
        "properties": {
          "path": {"type": "string", "minLength": 1, "maxLength": 512},
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "sizeBytes": {"type": "integer", "minimum": 0}
        }
      }
    }
  }
}
