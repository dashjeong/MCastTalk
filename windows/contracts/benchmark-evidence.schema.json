{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcasttalk.local/schemas/benchmark-evidence-v2.json",
  "title": "MCastTalk Gate 1 Benchmark Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "suiteId",
    "suiteVersion",
    "component",
    "candidateId",
    "candidateVersion",
    "hardwareFingerprint",
    "modelSha256",
    "runtimeSha256",
    "settingsSha256",
    "datasetSha256",
    "evaluatorSha256",
    "workloadSha256",
    "qualityMetrics",
    "requiredLanguages",
    "samples"
  ],
  "properties": {
    "schemaVersion": {"const": 2},
    "suiteId": {"type": "string", "minLength": 1},
    "suiteVersion": {"type": "string", "minLength": 1},
    "component": {"enum": ["asr", "nmt", "tts"]},
    "candidateId": {"type": "string", "minLength": 1},
    "candidateVersion": {"type": "string", "minLength": 1},
    "hardwareFingerprint": {"type": "string", "minLength": 1},
    "modelSha256": {"$ref": "#/$defs/sha256"},
    "runtimeSha256": {"$ref": "#/$defs/sha256"},
    "settingsSha256": {"$ref": "#/$defs/sha256"},
    "datasetSha256": {"$ref": "#/$defs/sha256"},
    "evaluatorSha256": {"$ref": "#/$defs/sha256"},
    "workloadSha256": {"$ref": "#/$defs/sha256"},
    "qualityMetrics": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "requiredLanguages": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 2}
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "latencyMs", "quality"],
        "properties": {
          "caseId": {"type": "string", "minLength": 1},
          "language": {"type": "string", "minLength": 2},
          "sourceLanguage": {"type": "string", "minLength": 2},
          "targetLanguage": {"type": "string", "minLength": 2},
          "inputDurationMs": {"type": "number", "exclusiveMinimum": 0},
          "outputDurationMs": {"type": "number", "exclusiveMinimum": 0},
          "latencyMs": {"type": "number", "exclusiveMinimum": 0},
          "quality": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {"type": "number"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"component": {"const": "nmt"}}},
      "then": {"properties": {
        "requiredLanguages": {"minItems": 2},
        "samples": {"items": {"required": ["sourceLanguage", "targetLanguage"]}}
      }}
    },
    {
      "if": {"properties": {"component": {"const": "asr"}}},
      "then": {"properties": {"samples": {"items": {"required": ["language", "inputDurationMs"]}}}}
    },
    {
      "if": {"properties": {"component": {"const": "tts"}}},
      "then": {"properties": {"samples": {"items": {"required": ["language", "outputDurationMs"]}}}}
    }
  ],
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
